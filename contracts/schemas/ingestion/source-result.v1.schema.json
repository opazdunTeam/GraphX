{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.local/schemas/ingestion/source-result.v1.schema.json",
  "title": "Source result v1",
  "description": "Successful source collection result, either inline or backed by a manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "attempt_no",
    "outcome",
    "record_count",
    "adapter_version",
    "parser_version",
    "mapping_version",
    "normalization_version",
    "digest",
    "artifacts",
    "manifest",
    "records",
    "claims",
    "warnings"
  ],
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    },
    "outcome": {
      "type": "string",
      "enum": ["succeeded", "not_found"]
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "parser_version": {
      "type": "string",
      "minLength": 1
    },
    "mapping_version": {
      "type": "string",
      "minLength": 1
    },
    "normalization_version": {
      "type": "string",
      "minLength": 1
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "artifact-reference.v1.schema.json"
      }
    },
    "manifest": {
      "oneOf": [
        {
          "$ref": "#/$defs/manifestReference"
        },
        {
          "type": "null"
        }
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "source-record.v1.schema.json"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "claim.v1.schema.json"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "manifest": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "manifest": {
              "$ref": "#/$defs/manifestReference"
            },
            "records": {
              "type": "array",
              "maxItems": 0
            },
            "claims": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "outcome": {
            "const": "not_found"
          }
        },
        "required": ["outcome"]
      },
      "then": {
        "type": "object",
        "properties": {
          "record_count": {
            "const": 0
          },
          "manifest": {
            "type": "null"
          },
          "records": {
            "type": "array",
            "maxItems": 0
          },
          "claims": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "manifestReference": {
      "allOf": [
        {
          "$ref": "artifact-reference.v1.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "manifest"
            },
            "media_type": {
              "const": "application/json"
            }
          }
        }
      ]
    }
  }
}
