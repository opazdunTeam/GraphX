{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.local/schemas/ingestion/artifact-reference.v1.schema.json",
  "title": "Artifact reference v1",
  "description": "Reference to immutable source material stored outside the message.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "local_ref",
    "kind",
    "object_key",
    "sha256",
    "media_type",
    "byte_size",
    "source_uri",
    "retrieved_at",
    "published_at",
    "http_metadata"
  ],
  "properties": {
    "local_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1F\u007F-\u009F]+$"
    },
    "kind": {
      "type": "string",
      "enum": ["raw_response", "document", "manifest", "screenshot", "other"]
    },
    "object_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^artifacts/v1/[0-9a-f-]{36}/[1-9][0-9]*/[A-Za-z0-9_-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "media_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    },
    "source_uri": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https?://(?:[A-Za-z0-9.-]+|\\[[0-9A-Fa-f:.]+\\])(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^?#\\s]*)?$"
    },
    "retrieved_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "http_metadata": {
      "type": "object",
      "propertyNames": {
        "enum": ["etag", "last-modified", "content-language"]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\r\\n]+$"
      }
    },
    "original_filename": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?:[^ ./\\\\\\x00-\\x1F\u007F-\u009F]|[^ ./\\\\\\x00-\\x1F\u007F-\u009F][^/\\\\\\x00-\\x1F\u007F-\u009F]{0,253}[^ ./\\\\\\x00-\\x1F\u007F-\u009F])$"
    },
    "parent_local_ref": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\x00-\\x1F\u007F-\u009F]+$"
    }
  }
}
