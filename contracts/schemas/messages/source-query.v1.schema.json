{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.local/schemas/messages/source-query.v1.schema.json",
  "title": "Source query v1",
  "description": "Minimum source-independent subject data required for discovery and enrichment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["person", "organization"]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "identifiers": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "minLength": 1
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": ["name"]
    },
    {
      "type": "object",
      "properties": {
        "identifiers": {
          "type": "object"
        }
      },
      "required": ["identifiers"]
    }
  ]
}
