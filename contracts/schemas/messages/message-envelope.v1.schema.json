{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://graphx.local/schemas/messages/message-envelope.v1.schema.json",
  "title": "GraphX message envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "message_id",
    "type",
    "schema_version",
    "occurred_at",
    "correlation_id",
    "producer",
    "root_command_id",
    "payload"
  ],
  "properties": {
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "causation_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "root_command_id": {
      "type": "string",
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
