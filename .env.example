# Common
APP_ENV=local
LOG_LEVEL=info
LOG_FORMAT=json

# Go API
API_HTTP_ADDR=:8080
API_PUBLIC_BASE_URL=http://localhost:8080
API_READ_HEADER_TIMEOUT=5s
API_READ_TIMEOUT=15s
API_WRITE_TIMEOUT=30s
API_IDLE_TIMEOUT=60s
API_SHUTDOWN_TIMEOUT=15s

# Web (Vite build/dev-server variable)
VITE_API_BASE_URL=/api/v1

# PostgreSQL
POSTGRES_DSN=postgres://graphx:change-me@postgres:5432/graphx?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_HEALTH_TIMEOUT=2s

# RabbitMQ
RABBITMQ_URL=amqp://graphx:change-me@rabbitmq:5672/graphx
RABBITMQ_PREFETCH_SOURCE=4
RABBITMQ_PREFETCH_DOCUMENT=2
RABBITMQ_PREFETCH_BROWSER=1
RABBITMQ_CONNECT_TIMEOUT=10s
RABBITMQ_PUBLISH_TIMEOUT=15s
CONTRACT_SCHEMA_ROOT=/app/contracts/schemas
TERMINAL_REPLAY_ROOT=/var/lib/graphx/worker-replay
TERMINAL_REPLAY_RETENTION=720h
TERMINAL_REPLAY_CLEANUP_INTERVAL=10m
TERMINAL_REPLAY_MAX_ENTRIES=100000
TERMINAL_REPLAY_MAX_BYTES=10737418240
TERMINAL_REPLAY_MAX_ENTRY_BYTES=2097152

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=local
S3_BUCKET_ARTIFACTS=graphx-artifacts
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_USE_PATH_STYLE=true
S3_ALLOW_OVERWRITE=false
S3_REQUIRE_VERSIONING=false
S3_CONNECT_TIMEOUT=10s
S3_READ_TIMEOUT=30s
S3_RECONCILIATION_TIMEOUT=3s
S3_MAX_INFLIGHT_OPERATIONS=16
ARTIFACT_MAX_BYTES=104857600
ARTIFACT_SPOOL_MAX_MEMORY_BYTES=1048576
ARTIFACT_SPOOL_DIRECTORY=
ARTIFACT_ALLOWED_MEDIA_TYPES=application/json,application/pdf,application/xml,application/zip,text/csv,text/html,text/plain,text/xml,image/jpeg,image/png,image/webp

# Investigation limits
INVESTIGATION_DEFAULT_DEPTH=1
INVESTIGATION_MAX_DEPTH=2
INVESTIGATION_DEFAULT_ENTITY_LIMIT=50
INVESTIGATION_MAX_ENTITY_LIMIT=100
INVESTIGATION_DISCOVERY_TIMEOUT=30s
INVESTIGATION_SOURCE_TIMEOUT=2m

# Worker defaults
WORKER_KIND=source
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL=15s
WORKER_JOB_TIMEOUT=5m
WORKER_SHUTDOWN_TIMEOUT=30s
PLAYWRIGHT_ENABLED=false

# Source feature flags and optional credentials.
# Enable a source only after its adapter is implemented and configured.
SOURCE_ICIJ_ENABLED=false
SOURCE_OPENSANCTIONS_ENABLED=false
SOURCE_KASE_ENABLED=false
SOURCE_KGD_ENABLED=false
SOURCE_KGD_API_TOKEN=
SOURCE_OPENCORPORATES_ENABLED=false
SOURCE_OPENCORPORATES_API_KEY=
