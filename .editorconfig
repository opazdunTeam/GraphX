root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml,json}]
indent_style = space
indent_size = 2

[*.go]
indent_style = tab

[*.py]
indent_style = space
indent_size = 4

[*.{ts,tsx,js,vue}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
